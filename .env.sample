# Copy this file to `.env` and edit the values for your environment.
# This repository does not auto-load .env files; set these variables in your shell
# or use a tool like direnv. Example:
#   export PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Path to a Chrome/Chromium executable to use instead of Puppeteer's bundled Chromium.
PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# If you install your own Chrome/Chromium and want to skip Puppeteer's download,
# set this to true in environments where you manage browsers separately.
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false
